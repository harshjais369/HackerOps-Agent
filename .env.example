# HackerOps Agent - Environment Variables

# LLM Configuration (LiteLLM supports gemini/gemini-2.5-flash, gpt-4o, claude-3-5-sonnet)
# If left empty, HackerOps automatically runs in high-fidelity deterministic Mock/Demo mode!
LLM_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash

# Database (Async SQLite in WAL mode for zero-config local dev, or PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./hackerops.db

# Safety Guardrails
# Set to 'true' to allow scanning RFC1918 private IPs (e.g. 127.0.0.1, 192.168.x.x, localhost) for local testing
ALLOW_LOCAL_TARGETS=false

# Docker Sandbox (optional: falls back to native async sandboxed executor if Docker is unavailable)
DOCKER_SANDBOX_IMAGE=hackerops-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=50000

# Redis / Queue (optional: in-memory async queue used automatically if Redis is unavailable)
REDIS_URL=redis://localhost:6379/0

# App Settings
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
