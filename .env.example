# ==============================================================================
# HackerOps Agent - Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Host Port Mappings (CRITICAL FOR MULTI-APP EC2 / VPS INSTANCES)
# ------------------------------------------------------------------------------
# Change these if you have existing services, Telegram bots, or web servers running!
#
# FRONTEND_PORT: The port you access in your browser (e.g., http://your-ip:4000)
# (Avoid 80, 443, 3000 if used by your other web app)
FRONTEND_PORT=4000

# BACKEND_PORT: FastAPI REST & WebSocket streaming port
# (Avoid 8000, or 8081 if running telegram-bot-api!)
BACKEND_PORT=8090

# REDIS_PORT: Redis cache port (Bound strictly to 127.0.0.1 on the host for security)
# (Avoid 6379 if your host or other bots already use standard Redis)
REDIS_PORT=6380

# ------------------------------------------------------------------------------
# 2. Safety & Guardrail Settings (STRICT HOST ISOLATION)
# ------------------------------------------------------------------------------
# CRITICAL FOR VPS: Keep ALLOW_LOCAL_TARGETS=false!
# When false, the agent refuses to scan localhost, 127.0.0.1, 172.x.x.x, or 192.168.x.x.
# This guarantees the agent will NEVER probe your other Telegram bots,
# internal databases, or local host services.
ALLOW_LOCAL_TARGETS=false

# ------------------------------------------------------------------------------
# 3. AI / LLM Remediation & Synthesis (Optional)
# ------------------------------------------------------------------------------
# Supports Gemini, OpenAI, Claude via LiteLLM.
# If left empty, HackerOps runs in high-fidelity deterministic mode (no API key required).
LLM_API_KEY=
LLM_MODEL=gemini/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. Database & Internal Storage
# ------------------------------------------------------------------------------
# SQLite with WAL mode (zero configuration, persistent in ./backend/data)
DATABASE_URL=sqlite+aiosqlite:///./hackerops.db

# ------------------------------------------------------------------------------
# 5. Security & Sandbox Configuration
# ------------------------------------------------------------------------------
DOCKER_SANDBOX_IMAGE=hackerops-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=15
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPU_QUOTA=50000

# ------------------------------------------------------------------------------
# 6. CORS & Network
# ------------------------------------------------------------------------------
CORS_ORIGINS=*
