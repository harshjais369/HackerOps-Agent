# ============================================================
# HackerOps Monorepo .dockerignore
# ============================================================

# Git
.git
.gitignore

# Environment files with credentials
.env
.env.local
*.env
!.env.example

# Local databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
hackerops.db*

# Python artifacts & virtual environments
__pycache__
*.py[cod]
*$py.class
*.so
.Python
venv/
venv*/
env/
env*/
backend/venv/
backend/env/
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Node / Next.js artifacts
node_modules
frontend/node_modules
.next
frontend/.next
frontend/out
npm-debug.log*

# Documentation & IDE
.vscode
.idea
*.md
!README.md
